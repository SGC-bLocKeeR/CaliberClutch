# Caliber Clutch - Steam Trade Bot Configuration
# Copy this file to .env and fill in your Steam Bot account credentials

# 1. Steam Account Credentials
STEAM_ACCOUNT_NAME=caliber_trading_bot_07
STEAM_PASSWORD=YourBotPasswordHere

# 2. Steam Guard Mobile 2FA Secrets (Extracted via Steam Desktop Authenticator / SDA)
# shared_secret is used to generate the 5-letter login 2FA code
STEAM_SHARED_SECRET=abcdef1234567890abcdef12345=
# identity_secret is used to automatically accept and confirm trade offers via 2FA
STEAM_IDENTITY_SECRET=123456abcdef123456abcdef1234=

# 3. Steam Web API Key (Get from: https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 4. Caliber Clutch Backend API Endpoint
CALIBER_API_URL=http://localhost:5175/api
CALIBER_BOT_SECRET_KEY=caliber_super_secure_bot_token_2026

# 5. Bot Settings
BOT_POLL_INTERVAL_MS=3000
BOT_TRADE_CANCEL_TIMEOUT_MS=600000
